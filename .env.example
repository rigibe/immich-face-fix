# Copy this file to .env and fill in your values.
# serve.py looks for .env next to itself, then in its parent directory,
# or you can point at a file explicitly with --env-file.

# Base URL of your Immich instance (no trailing /api).
IMMICH_URL=https://photos.example.com

# API key from Immich: Account Settings -> API Keys.
# See README.md for the minimum required permissions.
IMMICH_API_KEY=your-api-key-here

# Optional: local port for the proxy (default 8080).
# PORT=8080

# Optional: keep several keys and pick one with --api-key-var.
# IMMICH_API_KEY_WORK=another-api-key
